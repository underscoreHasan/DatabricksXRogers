# Ticketmaster Discovery consumerKey; server-only. No consumerSecret or OAuth is needed.
TICKETMASTER_API_KEY=

# Databricks Model Serving. Host without a trailing slash; token is a PAT or OAuth token.
# Server-only: separate selected-day and typical-day serving endpoints.
DATABRICKS_HOST=dbc-fff97889-921e.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_SERVING_ENDPOINT=waterfront-crowd-forecast
DATABRICKS_TYPICAL_SERVING_ENDPOINT=waterfront-crowd-forecast-dummy

# The selected-day endpoint serves the trained model.
DATABRICKS_MODEL_KIND=trained
